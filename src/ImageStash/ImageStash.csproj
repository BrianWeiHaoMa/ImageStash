<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The portable assembly never reaches Windows (F13, R1): an in-box Windows-only API fails the build here;
         tests/ImageStash.Tests/Portable checks what the compiler cannot see. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <!-- The Skia lease the editor's canvas draws through (S10); the same Avalonia.Skia that Avalonia.Desktop already ships. -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="KGySoft.Drawing.Core" Version="10.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageStash.Tests" />
    <InternalsVisibleTo Include="ImageStash.Windows.Tests" />
  </ItemGroup>

</Project>
